      },
      "state_body_classes": {
        "wbid-active": "theater overlay open, overflow hidden, nav hidden",
        "wbid-modal-open": "modal open, FAB hidden",
        "player-mobile-fs": "mobile native/CSS fullscreen"
      }
    },

    "responsive_rules": {
      "mobile_max_768": {
        "nav": "full width pill, shorter height, hide some links",
        "hero": "shorter min-height, smaller h1",
        "player": "compact bar, icon actions, 56.25% ratio",
        "sections": "reduced padding 52px 16px",
        "feat_grid": "single column",
        "alt_row": "single column, hide alt-visual-card",
