        "alt_row_gap": "44px"
      }
    },

    "reuse_guide": {
      "quick_start": [
        "1. Copy Design.json, ShapeGrid.js, and js/perf-controller.js into new project",
        "2. Add Google Fonts Inter link and define :root CSS vars from design_system.style.css_custom_properties",
        "3. Fetch Design.json at runtime and call applyDesignPalette() to set --bg, --highlight, --btn-primary-* etc.",
        "4. Init ShapeGrid on a fixed #sg-global-bg div using design_system.background.shapegrid defaults",
        "5. Apply component class names and structure from design_system.components",
        "6. Include all @keyframes and animation utility classes from design_system.animations",
        "7. Wire PerfController for playback-aware motion reduction"
      ],
      "runtime_palette_mapping": {
        "primary_bg": "--bg",
        "glass_surface": "--surface, --surface-2",
        "glass_border": "--glass-border",
        "highlight": "--highlight",
        "text_primary": "--text-1",
        "text_secondary": "--text-2",
        "components.buttons.primary.background": "--btn-primary-bg",
        "components.buttons.primary.color": "--btn-primary-fg"
      },
      "icon_sizes": {
        "nav_inline": "15–16px",
        "btn_inline": "15px",
        "feat_card": "20px",
        "player_actions": "12–15px",
        "wbid_fab": "14px (+ morph scale)"
