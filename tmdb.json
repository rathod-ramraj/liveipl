  "usageRules": {
    "placeholders": {
      "{tmdbId}": "Replace with the primary TMDB numeric ID for the movie or TV show.",
      "{imdbId}": "Replace with the IMDb title ID starting with 'tt' (used in fallbacks or specific APIs).",
      "{season}": "Replace with the requested season number (positive integer, e.g. 1). Defaults to 1.",
      "{episode}": "Replace with the requested episode number (positive integer, e.g. 1). Defaults to 1.",
      "{hex}": "Optional placeholder representing theme accent color in hexadecimal format (e.g. ff4d6d)."
    },
    "routingLogic": [
      "If tmdbId is present and the server supports TMDB (tmdbSupported is true), use it as the primary parameter.",
      "If the server does not support IMDb (imdbSupported is false), you MUST use tmdbId.",
      "For TV Shows / Episodes, always replace {season} and {episode} with positive integers (fallback to 1 if undefined)."
    ]
  }
